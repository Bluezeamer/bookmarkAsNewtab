# ADR-006: 单 Bearer token（.env 注入, 不入库）
# 未配置时 server 对 /api 与 /ws fail-closed（全拒）
SYNC_TOKEN=change-me-to-a-long-random-string

# 可选: 部署方显示名（页首问候语）; 不配置则问候语不带名字
# OWNER_NAME=你的名字

# 可选: 数据目录（CRDT 快照 + history.jsonl）
# 生产必须指向 current/ 之外的持久路径（release 目录每次部署被替换）
# DATA_DIR=/var/lib/bnt/data

# 可选: 自动分类（ADR-005）—— 不配置则完全 no-op（/api/classify 返回 enabled:false）
# 任意 OpenAI 兼容端点（如 vLLM）: URL 到 /v1 为止
# CLASSIFIER_URL=http://localhost:8000/v1
# CLASSIFIER_MODEL=Qwen3.8-27B
# CLASSIFIER_API_KEY=
# 注意: reasoning 类模型（输出里带 reasoning_content）的推理也占用 max_tokens,
# 预算给小了会只剩推理、content 为空 → 判为失败; 默认 512 起步, 不够再加
# CLASSIFIER_TIMEOUT_MS=30000
# CLASSIFIER_MAX_TOKENS=512
